## Install bluetooth.para to /system/etc/param/bluetooth.para
## Install bluetooth.para.dac to /system/etc/param/bluetooth.para.dac

import("//build/ohos.gni")
import("//build/ohos_var.gni")

group("etc") {
  deps = [
    ":bluetooth.para",
    ":bluetooth.para.dac",
  ]
}

ohos_prebuilt_etc("bluetooth.para") {
  if (factory == true) {
    source = "bluetooth_factory.para"
  } else {
    source = "bluetooth.para"
  }
  part_name = "bluetooth"
  subsystem_name = "communication"
  relative_install_dir = "param"
}

ohos_prebuilt_etc("bluetooth.para.dac") {
  source = "bluetooth.para.dac"
  part_name = "bluetooth"
  subsystem_name = "communication"
  relative_install_dir = "param"
}