import("//build/ohos.gni")
import("//foundation/communication/bluetooth/bluetooth.gni")

config("bluetooth_hdi_adapter_public_config") {
  include_dirs = [
    "include",
  ]
}

ohos_shared_library("bluetooth_hdi_adapter") {
  branch_protector_ret = "pac_ret"  # Enable PAC CFI
  # stack_protector_ret = true
  sanitize = {
      cfi = true                             # Enable/disable control flow integrity detection
      boundary_sanitize = true               # Enable boundary san detection
      cfi_cross_dso = true                   # Cross-SO CFI Checks
      integer_overflow = true                # Enable integer overflow detection
      ubsan = true                           # Enable some Ubsan options
      debug = false
  }
  include_dirs = [
    "include",
  ]

  cflags = [ "-fPIC" ]

  cflags_cc = [
    "-Os",
    "-fno-rtti",
    "-fno-exceptions",
    "-fdata-sections",
    "-ffunction-sections",
    "-fno-unwind-tables",
    "-fno-asynchronous-unwind-tables",
    "-fno-merge-all-constants",
    "-flto",
  ]

  configs = [
    "${bluetooth_config_path}:feature_flags",
  ]

  public_configs = [
    ":bluetooth_hdi_adapter_public_config",
  ]

  sources = [
    "src/bluetooth_hci_callbacks.cpp",
    "src/bluetooth_hdi.cpp",
  ]

  deps = [ ]

  if (is_standard_system) {
    external_deps = [
      "c_utils:utils",
      "drivers_interface_bluetooth:libbluetooth_hci_proxy_1.0",
      "hdf_core:libhdi",
      "hilog:libhilog",
      "ipc:ipc_single",
      "hitrace:hitrace_meter",
      "bounds_checking_function:libsec_shared",
    ]
  } else {
    external_deps = [
      "c_utils:utils",
      "drivers_interface_bluetooth:libbluetooth_hci_proxy_1.0",
      "hdf_core:libhdi",
      "hilog:libhilog",
      "ipc:ipc_single",
      "hitrace:hitrace_meter",
      "bounds_checking_function:libsec_shared",
    ]
  }

  subsystem_name = "communication"
  part_name = "bluetooth"
}
