import("//build/ohos.gni")

BT_ROOT = "//foundation/communication/bluetooth/services/bluetooth"

config("btdummy_config") {
  cflags_cc = [
    "-Os",
    "-fno-rtti",
    "-fno-exceptions",
    "-fdata-sections",
    "-ffunction-sections",
    "-fno-unwind-tables",
    "-fno-asynchronous-unwind-tables",
    "-fno-merge-all-constants",
    "-flto",
    "-fPIC",
    "-Wno-unused-private-field",
    "-Wno-format-nonliteral",
    "-Wno-non-c-typedef-for-linkage",
  ]
  include_dirs = [ "$BT_ROOT/common" ]
}

config("btdummy_public_config") {
  include_dirs = [ "dummy/include" ]
}

ohos_shared_library("btdummy") {
  branch_protector_ret = "pac_ret"  # Enable PAC CFI
  # stack_protector_ret = true
  sanitize = {
      cfi = true                             # Enable/disable control flow integrity detection
      boundary_sanitize = true               # Enable boundary san detection
      cfi_cross_dso = true                   # Cross-SO CFI Checks
      integer_overflow = true                # Enable integer overflow detection
      ubsan = true                           # Enable some Ubsan options
      debug = false
  }
  configs = [ ":btdummy_config" ]
  public_configs = [ ":btdummy_public_config" ]
  sources = [ "dummy/src/stub.cpp" ]
  deps = [ "//foundation/communication/bluetooth/frameworks/inner:btcommon" ]
  external_deps = [
    "hilog:libhilog",
  ]
  subsystem_name = "communication"
  part_name = "bluetooth"
}
