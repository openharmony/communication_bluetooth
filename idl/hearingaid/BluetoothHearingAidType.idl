package OHOS.Bluetooth;
 
/**
* The enum of hearing aid device side.
*/
enum DeviceSide {
    DEVICE_SIDE_LEFT = 0,
    DEVICE_SIDE_RIGHT = 1
};

/**
* The enum of hearing aid device mode.
*/
enum DeviceMode {
    DEVICE_MODE_MONAURAL = 0,
    DEVICE_MODE_BINAURAL = 1
};

/**
* The enum of hearingAid connection state.
*/
enum ConnectionState {
    STATE_CONNECTING = 0,
    STATE_CONNECTED = 1,
    STATE_DISCONNECTING = 2,
    STATE_DISCONNECTED = 3
};

/**
* The enum of hearingAid connection strategy.
*/
enum ConnectionStrategy {
    CONNECTION_STRATEGY_UNSUPPORTED = 0,
    CONNECTION_STRATEGY_ALLOWED = 1,
    CONNECTION_STRATEGY_FORBIDDEN = 2
};
