package OHOS.Bluetooth;

import BluetoothHearingAidType;

[callback] interface OHOS.Bluetooth.IBluetoothHearingAidObserver {
   [oneway] void OnConnectionStateChanged([in] String address, [in] ConnectionState state, [in] int cause);
   [oneway] void OnActiveDeviceChanged([in] String address, [in] String name);
}