import("//build/ohos.gni")
import("//build/ohos_var.gni")
import("//foundation/communication/bluetooth/bluetooth.gni")

BT_ROOT = "//foundation/communication/bluetooth"

config("hearingaid_config") {
  cflags_cc = [
    "-Os",
    "-fno-rtti",
    "-fno-exceptions",
    "-fdata-sections",
    "-ffunction-sections",
    "-fno-unwind-tables",
    "-fno-asynchronous-unwind-tables",
    "-fno-merge-all-constants",
    "-flto",
    "-fPIC",
    "-Wno-unused-parameter",
    "-Wno-return-type-c-linkage",
    "-Wunused-private-field",
  ]

  include_dirs = [
      "$BT_ROOT/services/bluetooth/common",
    ]

  defines = []
  if (is_asan || use_clang_coverage) {
    defines += [ "DTFUZZ_TEST" ]
  }
}

config("hearingaid_public_config") {
  include_dirs = [
    "$BT_ROOT/frameworks/inner/include",
  ]
}

ohos_shared_library("hearingaid_framework") {
  sanitize = {
    cfi = true
    boundary_sanitize = true
    integer_overflow = true
    cfi_cross_dso = true
    debug = false
    ubsan = true
  }
  branch_protector_ret = "pac_ret"
  version_script = "libhearingaid_version_script.txt"
  configs = [ ":hearingaid_config" ]
  public_configs = [ ":hearingaid_public_config" ]

  sources = [
    "bluetooth_hearingaid.cpp",
  ]

  deps = [
    "$BT_ROOT/idl/hearingaid:libbluetooth_hearingaid_interface_proxy",
    "$BT_ROOT/idl/hearingaid:libbluetooth_hearingaid_interface_stub",
  ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_core",
    "ipc:ipc_napi",
    "napi:ace_napi",
    "bluetooth:btframework",
    "bluetooth:btcommon",
    "samgr:samgr_proxy",
    "hitrace:hitrace_meter",
  ]

  part_name = "bluetooth"
  subsystem_name = "communication"
}
