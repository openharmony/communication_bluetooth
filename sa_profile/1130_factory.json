{
    "process":"bluetooth_service",
    "systemability":[
        {
            "name":1130,
            "libpath":"/system/lib64/libbluetooth_server.z.so",
            "run-on-create":false,
            "auto-restart":true,
            "distributed":false,
            "dump-level":1,
            "min_hdi_proxy_version": ["libbluetooth_hci_proxy_1.0.z.so"],
            "start-on-demand":{
                "allow-update":false,
                "commonevent":[
                    {
                        "name":"usual.event.EXIT_SYSTEM_STR_MODE",
                        "conditions":[
                            {
                                "eventId":"param",
                                "name":"persist.bluetooth.watch_str_enable",
                                "value":"1"
                            }
                        ]
                    }
                ]
            }
        }
    ]
}